# Lo que NO se sube al despliegue (sí queda en GitHub).
# El build de Next solo necesita src/, public/, package.json, pnpm-lock.yaml y
# los archivos de configuración; el resto es material de desarrollo y QA.

# Scripts de QA (R, Python, MDX). Se ejecutan en local, no en el servidor.
scripts/

# Pruebas: snapshots de R y capturas de Playwright (~48 MB)
tests/

