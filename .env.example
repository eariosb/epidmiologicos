# Variables de entorno — copiar a .env.local (NUNCA commitear el archivo real)
# Ver prueba-campo/docs/02-esquema-supabase.md §6
#
# La app funciona sin ninguna de estas variables: el curso, los simuladores y
# las celdas de R no dependen de Supabase. Sin ellas, la prueba de campo queda
# inactiva (no se registra nada) y el tablero docente responde 403.

# --- Prueba de campo (opcional) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REEMPLAZAR.supabase.co
# SOLO servidor: /api/track, /api/feedback, /api/consent, /api/mis-datos.
# Jamás debe llevar el prefijo NEXT_PUBLIC_ ni llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR-service-role-key
# Tablero docente /admin/fieldtest y /api/fieldtest/* (token largo y aleatorio)
FIELDTEST_ADMIN_TOKEN=REEMPLAZAR-token-docente-largo-y-aleatorio

# --- Pruebas exactas (opcional) -------------------------------------------
# 0 desactiva el worker de inferencia exacta (fallback para despliegues con
# restricciones de memoria). Por defecto está activo.
NEXT_PUBLIC_EXACT_WORKER=1

# --- Pizarra con cámara (opcional, solo That_Board) -----------------------
# Servicio Python local que publica la posición del puntero. Si se deja vacío
# en producción, /api/vision/* responde 503 y el resto del curso no se afecta.
# No lo configures en un despliegue público: el proxy no tiene autenticación.
VISION_SERVICE_URL=
