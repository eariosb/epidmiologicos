{
  "name": "curso-epidemiologia",
  "version": "0.1.0",
  "private": true,
  "description": "Análisis Estadístico de Datos Epidemiológicos: curso interactivo con R en el navegador (webR), basado en Woodward y el material del profesor Juan Carlos Salazar Uribe. Universidad Nacional de Colombia, sede Medellín.",
  "author": "Esneider Ríos",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/dev-clean.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mdx": "tsx scripts/check_mdx.mjs",
    "check:render": "tsx scripts/check_render.mjs",
    "check:glossary": "tsx scripts/glossary_coverage.mjs",
    "claims": "tsx scripts/build-claims.ts",
    "check:r": "python scripts/run_all_r.py --check",
    "check:r:update": "python scripts/run_all_r.py --update",
    "test:visual": "playwright test tests/visual/modules.spec.ts",
    "test:visual:update": "playwright test tests/visual/modules.spec.ts --update-snapshots",
    "qa": "pnpm typecheck && pnpm build && pnpm test && pnpm check:mdx && pnpm check:render && pnpm check:glossary && pnpm check:cells && pnpm check:r && pnpm test:layout",
    "precompute": "python scripts/precompute_r.py",
    "precompute:check": "python scripts/lint_cells.py",
    "check:cells": "python scripts/lint_cells.py",
    "test:layout": "playwright test tests/visual/overflow.spec.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@cursos/blackboard": "workspace:*",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "2",
    "@uiw/react-codemirror": "^4.23.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.11",
    "lucide-react": "^1.52.0",
    "next": "^15.1.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "webr": "^0.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
